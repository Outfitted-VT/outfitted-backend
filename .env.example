PROJECT_NAME="Outfitted API"
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]
# Postgres (postgres:// and postgresql:// are rewritten to use the psycopg driver)
DATABASE_URL=postgresql://postgres:password@localhost:5432/outfitted
# Or SQLite, no server needed:
# DATABASE_URL=sqlite:///./outfitted.db

# Uploaded images are stored in MEDIA_ROOT and served from MEDIA_BASE_URL.
MEDIA_ROOT=media
MEDIA_BASE_URL=http://localhost:8000/media

# Signs login tokens. Optional in development (an insecure default is used);
# required outside development, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Refresh token cookie. Keep Secure on in production. SameSite: "lax" when frontend and API
# share a site (localhost:3000 + localhost:8000, or app.x.com + api.x.com); "none" otherwise.
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax

# Virtual try-on (POST /tryons). Off until GOOGLE_CLOUD_PROJECT is set. Locally, authenticate
# once with: gcloud auth application-default login
# GOOGLE_CLOUD_PROJECT=your-project-id
# gemini-3.1-flash-image (default), gemini-3-pro-image, or virtual-try-on-001 (deprecated)
# TRYON_MODEL=gemini-3.1-flash-image
# Defaults to "global" for Gemini models and "us-central1" for virtual-try-on-001.
# TRYON_LOCATION=
# TRYON_DAILY_LIMIT=20

# Piece detection (POST /detections). Uses the same project and credentials as try-on.
# DETECTION_MODEL=gemini-3.1-flash-lite
# DETECTION_DAILY_LIMIT=200

# Shop links for detected pieces: Google Lens visual search via SerpApi (serpapi.com).
# Off until set. Each located piece is one paid search, at most SHOP_MATCH_MAX_ITEMS per photo.
# SERPAPI_API_KEY=
# SHOP_MATCH_COUNTRY=us
# SHOP_MATCH_MAX_ITEMS=6
